# Local Supabase API URL (from `npx supabase status` after `npm run db:start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Local Supabase anon key (from `npx supabase status`).
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-anon-key

# Enables the corner identity switcher (local demo only).
STUB_AUTH=true

# Shared password for all seeded demo users (see supabase/seed.sql).
SEED_USER_PASSWORD=replace-with-seed-password
